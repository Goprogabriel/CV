---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/let-there-be-light.css';
---

<BaseLayout
  locale="en"
  title="LetThereBeLight — Live hand-controlled relighting by Gabriel Back"
  description="Move a virtual light through a live camera scene with your hand using on-device MediaPipe tracking, monocular depth estimation and WebGPU."
  navigationMode="projects"
  ogImage="/media/projects/let-there-be-light.jpg"
>
  <main id="main" class="light-experience" data-light-app>
    <section class="light-workspace" data-nav-theme="dark">
      <div class="light-stage" data-light-stage data-state="busy">
        <canvas
          class="light-canvas"
          data-light-canvas
          width="1"
          height="1"
          aria-label="Live camera with hand-controlled virtual lighting"
        ></canvas>
        <canvas class="light-hand-overlay" data-hand-overlay width="1" height="1" aria-hidden="true"></canvas>
        <video data-light-video autoplay muted playsinline hidden></video>

        <div class="light-vignette" aria-hidden="true"></div>
        <h1 class="sr-only">LetThereBeLight</h1>

        <div class="light-hud" aria-label="Live project status">
          <span class="light-live"><i></i> Live camera</span>
          <span data-hand-status data-state="loading"><i></i><b>Loading hand control</b></span>
          <span class="light-device">Large depth model · on device</span>
        </div>

        <div class="light-hand-guide" data-hand-guide>
          <span class="light-hand-guide-icon" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i>
          </span>
          <p><strong>Raise one hand.</strong> Your index finger places the light.</p>
          <div><span>← → · left / right</span><span>↑ ↓ · up / down</span><span>near / far · depth</span></div>
        </div>

        <div class="light-depth-meter" data-depth-meter aria-hidden="true">
          <span>Near</span>
          <div><i></i></div>
          <span>Far</span>
        </div>

        <div class="light-status" data-light-status role="status" aria-live="polite">
          <span class="light-spinner" aria-hidden="true"></span>
          <p class="light-status-kicker" data-status-kicker>Preparing WebGPU</p>
          <p class="light-status-message" data-status-message>Connecting to your graphics processor…</p>
          <p class="light-status-note">Camera and hand processing stay on this device.</p>
          <button class="light-retry" data-light-retry type="button" hidden>Try again</button>
        </div>

        <p class="light-gesture-hint">Finger controls position · move your hand closer or farther for depth</p>
        <button class="light-credits-trigger" data-credits-open type="button">Credits <span>↗</span></button>
      </div>
    </section>
  </main>

  <button
    class="settings-fab"
    data-settings-open
    type="button"
    aria-label="Open light settings"
    aria-controls="light-settings"
    aria-expanded="false"
  >
    <span class="settings-icon" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>

  <dialog id="light-settings" class="light-settings" data-settings-dialog aria-labelledby="settings-title">
    <div class="settings-panel">
      <header class="settings-header">
        <div>
          <p class="eyebrow">Live controls</p>
          <h2 id="settings-title">Shape the light.</h2>
        </div>
        <button class="settings-close" data-settings-close type="button" aria-label="Close settings">×</button>
      </header>

      <div class="settings-scroll">
        <div class="hand-control-setting">
          <div>
            <strong>Hand control</strong>
            <small>Index finger moves the light. Hand distance controls depth.</small>
          </div>
          <label class="settings-toggle">
            <input data-hand-toggle type="checkbox" checked />
            <span aria-hidden="true"></span>
            <span class="sr-only">Enable hand control</span>
          </label>
        </div>

        <fieldset class="camera-switch">
          <legend>Camera</legend>
          <label><input type="radio" name="camera-facing" value="front" checked /><span>Front</span></label>
          <label><input type="radio" name="camera-facing" value="back" /><span>Back</span></label>
        </fieldset>

        <div class="setting-list">
          <label class="setting-row" for="light-intensity">
            <span>Intensity <output data-output="intensity" for="light-intensity">3</output></span>
            <input id="light-intensity" data-setting="intensity" type="range" min="0" max="3.5" step="0.05" value="3" />
          </label>
          <label class="setting-row" for="light-ambient">
            <span>Ambient <output data-output="ambient" for="light-ambient">0.5</output></span>
            <input id="light-ambient" data-setting="ambient" type="range" min="0" max="1.2" step="0.05" value="0.5" />
          </label>
          <label class="setting-row" for="light-relief">
            <span>Relief <output data-output="relief" for="light-relief">0.85</output></span>
            <input id="light-relief" data-setting="relief" type="range" min="0" max="2.5" step="0.05" value="0.85" />
          </label>
          <label class="setting-row" for="light-shadow">
            <span>Shadow <output data-output="shadow" for="light-shadow">0.7</output></span>
            <input id="light-shadow" data-setting="shadow" type="range" min="0" max="1" step="0.05" value="0.7" />
          </label>
          <label class="setting-row" for="light-occlusion">
            <span>Occlusion <output data-output="occlusion" for="light-occlusion">0.55</output></span>
            <input id="light-occlusion" data-setting="occlusion" type="range" min="0" max="1" step="0.05" value="0.55" />
          </label>
          <label class="setting-color" for="light-color">
            <span><strong>Light color</strong><small>Choose a warm or cool source.</small></span>
            <input id="light-color" data-setting="color" type="color" value="#ffb875" />
          </label>
        </div>

        <button class="settings-reset" data-settings-reset type="button">Reset light settings</button>

        <div class="settings-storage">
          <label><input data-cache-toggle type="checkbox" checked /> Keep the depth model on this device</label>
          <button data-clear-cache type="button">Clear downloaded model</button>
        </div>

        <aside class="light-credits" data-credits tabindex="-1">
          <p class="eyebrow">Credits</p>
          <p>
            Adapted from the
            <a href="https://github.com/software-mansion/TypeGPU/tree/main/apps/typegpu-docs/src/examples/image-processing/monocular-light-injection" target="_blank" rel="noreferrer">Monocular Light Injection experiment</a>
            in TypeGPU by Software Mansion, created by
            <a href="https://x.com/reczko_konrad" target="_blank" rel="noreferrer">Konrad Reczko</a>.
          </p>
          <p>
            Browser-based hand landmarks are provided by
            <a href="https://ai.google.dev/edge/mediapipe/solutions/vision/hand_landmarker/web_js" target="_blank" rel="noreferrer">Google MediaPipe Hand Landmarker</a>.
          </p>
          <p class="light-credits-note">Interface adaptation and CV integration by Gabriel Back.</p>
        </aside>
      </div>
    </div>
  </dialog>

  <script>
    import '@/features/let-there-be-light/app';
  </script>
</BaseLayout>
