---
import { profile } from '@/content/profile';
import { site } from '@/content/site';
import { socials } from '@/content/socials';
import type { Locale } from '@/types/content';
const { locale } = Astro.props as { locale: Locale };
---
<section class="section section--dark" id="contact" data-nav-theme="dark">
  <div class="shell contact-grid">
    <div class="contact-heading"><h2 class="contact-title reveal">{locale === 'da' ? 'Har I et produkt, der skal helt i mål?' : 'Do you have a product that needs to get all the way?'}</h2><svg class="contact-system" viewBox="0 0 720 500" role="img" aria-label={locale === 'da' ? 'Et systemforløb fra behov gennem produkt, kode og release til stabil drift' : 'A system journey from need through product, code and release to reliable operations'}><defs><path id="contact-route" d="M50 332C118 132 245 122 318 252S492 420 665 190"/><path id="contact-return" d="M74 396C188 454 286 430 356 330S500 116 654 126"/></defs><circle class="contact-system-orbit contact-system-orbit--one" cx="225" cy="246" r="105"/><circle class="contact-system-orbit contact-system-orbit--two" cx="510" cy="252" r="126"/><path class="contact-system-track" d="M50 332C118 132 245 122 318 252S492 420 665 190"/><path class="contact-system-flow" d="M50 332C118 132 245 122 318 252S492 420 665 190"/><path class="contact-system-track contact-system-track--secondary" d="M74 396C188 454 286 430 356 330S500 116 654 126"/><path class="contact-system-flow contact-system-flow--secondary" d="M74 396C188 454 286 430 356 330S500 116 654 126"/><g class="contact-system-core" transform="translate(364 268)"><circle class="contact-system-core-ring" r="54"/><circle class="contact-system-core-dot" r="8"/><text y="4" text-anchor="middle">SYSTEM</text></g><g class="contact-system-node" transform="translate(52 332)"><circle r="8"/><text y="31">{locale === 'da' ? 'BEHOV' : 'NEED'}</text></g><g class="contact-system-node contact-system-node--2" transform="translate(174 174)"><circle r="8"/><text y="31">{locale === 'da' ? 'PRODUKT' : 'PRODUCT'}</text></g><g class="contact-system-node contact-system-node--3" transform="translate(318 252)"><circle r="8"/><text x="-10" y="-18" text-anchor="end">{locale === 'da' ? 'ARKITEKTUR' : 'ARCHITECTURE'}</text></g><g class="contact-system-node contact-system-node--4" transform="translate(458 378)"><circle r="8"/><text y="31">{locale === 'da' ? 'KODE' : 'CODE'}</text></g><g class="contact-system-node contact-system-node--5" transform="translate(565 270)"><circle r="8"/><text y="31">RELEASE</text></g><g class="contact-system-node contact-system-node--6" transform="translate(665 190)"><circle r="8"/><text x="-3" y="31" text-anchor="end">{locale === 'da' ? 'DRIFT' : 'LIVE'}</text></g><circle class="contact-particle" r="5"><animateMotion dur="7s" repeatCount="indefinite"><mpath href="#contact-route"/></animateMotion></circle><circle class="contact-particle contact-particle--two" r="4"><animateMotion dur="10s" begin="-3s" repeatCount="indefinite"><mpath href="#contact-return"/></animateMotion></circle></svg></div>
    <div class="contact-details"><p class="lead">{site.availability[locale]}</p><div class="contact-links"><a href={`mailto:${socials.email}`}><span>Email</span><span>{socials.email}</span></a><a href={`tel:${socials.phone.replaceAll(' ', '')}`}><span>{locale === 'da' ? 'Telefon' : 'Phone'}</span><span>{socials.phone}</span></a><a href={socials.linkedin}><span>LinkedIn</span><span>↗</span></a><a href={socials.github}><span>GitHub</span><span>↗</span></a></div><p class="contact-meta">{profile.location[locale]} · {profile.role[locale]}</p></div>
  </div>
</section>
